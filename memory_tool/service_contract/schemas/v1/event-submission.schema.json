{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://los-memory.invalid/service-contract/v1/event-submission.schema.json",
  "title": "EventSubmission",
  "description": "A client event batch item. Server-owned fields (owner_id, space_id, device_id, actor_agent_id, visibility, server_seq, receipt_*) are not part of this shape and are refused if submitted.",
  "version": "1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "client_event_id",
    "source",
    "source_seq",
    "role",
    "observed_at",
    "content"
  ],
  "properties": {
    "contract_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "client_event_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "source_instance": {"type": "string", "maxLength": 200},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_app"],
      "properties": {
        "source_app": {"type": "string", "minLength": 1, "maxLength": 100},
        "thread_id": {"type": "string", "maxLength": 200}
      }
    },
    "source_seq": {"type": "integer", "minimum": 0},
    "role": {"type": "string", "enum": ["user", "assistant", "tool", "system"]},
    "observed_at": {"type": "string", "minLength": 1, "maxLength": 64},
    "content": {"type": "string", "minLength": 1},
    "project_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "requested_scope": {"$ref": "#/definitions/requested_scope"},
    "memory": {"$ref": "#/definitions/memory_proposal"}
  },
  "definitions": {
    "requested_scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "projects": {"type": "array", "items": {"type": "string", "minLength": 1}, "maxItems": 64},
        "spaces": {"type": "array", "items": {"type": "string", "minLength": 1}, "maxItems": 64},
        "owner_shared": {"type": "boolean"}
      }
    },
    "evidence_link": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "revision", "span"],
      "properties": {
        "source_id": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1},
        "span": {"type": "string", "minLength": 1}
      }
    },
    "memory_proposal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "content"],
      "properties": {
        "contract_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "kind": {"type": "string", "minLength": 1, "maxLength": 64},
        "content": {"type": "string", "minLength": 1},
        "claim_status": {
          "type": ["string", "null"],
          "enum": ["proposed", "asserted", "unverified", "undeclared", null]
        },
        "memory_id": {"type": ["string", "null"], "minLength": 1},
        "base_revision": {"type": ["string", "null"], "minLength": 1},
        "valid_from": {"type": ["string", "null"], "minLength": 1},
        "valid_to": {"type": ["string", "null"], "minLength": 1},
        "evidence": {"type": "array", "items": {"$ref": "#/definitions/evidence_link"}},
        "project_id": {"type": ["string", "null"], "minLength": 1},
        "requested_scope": {"$ref": "#/definitions/requested_scope"}
      }
    }
  }
}
