      },
      {
        "name": "other-repo",
        "role": "child",
        "purpose": "Additional repo as needed",
        "acceptanceState": null,
        "blockers": []
      }
    ]
  },
  "recordSchema": {
    "executionProgress": {
      "stage": "execution",
      "kind": "progress",
      "requiredFields": ["traceId", "parentTaskId", "childTaskId", "sessionId", "summary"],
      "optionalFields": ["details", "timestamp", "agent"]
    },
    "verificationCheckpoint": {
      "stage": "verification",
      "kind": "checkpoint",
      "requiredFields": ["traceId", "parentTaskId", "childTaskId", "sessionId", "summary", "result"],
      "optionalFields": ["command", "output", "timestamp", "agent"],
      "resultValues": ["PASS", "FAIL", "SKIP", "WARNING"]
    },
    "resultArtifact": {
      "stage": "result",
      "kind": "artifact",
      "requiredFields": ["traceId", "parentTaskId", "childTaskId", "sessionId", "summary", "acceptanceState"],
      "optionalFields": ["artifactPath", "verificationOutput", "recommendations", "timestamp", "agent"],
      "acceptanceStates": ["ACCEPTED", "ACCEPTED_WITH_NOTES", "BLOCKED"]
    },
    "blockerEscalation": {
      "stage": "result",
      "kind": "blocker",
      "requiredFields": ["traceId", "parentTaskId", "childTaskId", "sessionId", "summary", "acceptanceState", "blockerType", "escalationTarget"],
      "optionalFields": ["details", "workaround", "timestamp", "agent"],
      "blockerTypes": ["PATH_UNRESOLVED", "CONTRACT_UNRESOLVED", "DEPENDENCY_MISSING", "PERMISSION_DENIED", "SCHEMA_MISMATCH"]
    }
  },
  "verificationCommands": {
    "los-memory": [
      "python3 -c \"from memory_tool import connect_db, run_search; print('OK')\"",
      "los-memory memory list --limit 5",
      "los-memory admin doctor --output json"
    ],
    "generic": [
      "python3 -c \"import {module}; print('OK')\"",
      "ls -la {repo_path}",
      "git -C {repo_path} status"
    ]
  },
  "artifactPaths": {
