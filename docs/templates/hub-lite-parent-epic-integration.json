      "Verification commands recorded as checkpoints",
      "Parent summary records acceptance state, blockers, and next steps"
    ]
  },
  "childSessions": {
    "description": "Child session definitions for each participating repository",
    "pattern": {
      "traceId": "trace-parent-epic-20260309000327",
      "parentTaskId": "epic-20260309000327",
      "childTaskId": "{repo-name}-20260309000327",
      "sessionId": "child-{repo-name}-20260309000327",
      "targetProjectPath": "{resolved-local-path}",
      "rules": [
        "Only edit this repo",
        "Do not mutate another repo interface directly",
        "If repo path or frozen contract is unresolved, stop and escalate"
      ]
    },
    "expectedRepos": [
      {
        "name": "los-memory",
        "role": "control-plane",
        "purpose": "Hub-lite control plane and session aggregation",
        "acceptanceState": null,
        "blockers": []
      },
      {
        "name": "lsclaw",
        "role": "child",
        "purpose": "Validate law-specific memory patterns",
        "acceptanceState": null,
        "blockers": []
      },
      {
        "name": "hapi",
